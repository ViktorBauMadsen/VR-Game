  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::BlackjackDealer
  head: {fileID: 12446202}
  body: {fileID: 291574295}
  shoulders:
  - {fileID: 211730666}
  - {fileID: 1238336104}
  hands:
  - {fileID: 107965261}
