--- !u!114 &1298142824
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1298142822}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: d6bd2defdcfc560478dded90001869da, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::WorldTextPanel
  text: '<align=left><color=#FFD24A><b>THE TABLES</b></color>

    <size=72%><b>ROULETTE</b>  drop chips on numbers or colours, press the spin button. Pick a chip back up to cancel the bet.


    <b>BLACKJACK</b>  - / + sets the bet, then DEAL. HIT, STAND or DOUBLE. Blackjack pays 3 to 2.


    <b>SLOTS</b>  set the bet, grab the lever and pull.


    <b>BAR</b>  order at the counter. Drinks cost money - and aim.


    Point at a dealer and squeeze grip for tips.</size>'
  textColor: {r: 1, g: 1, b: 1, a: 1}
  background: {r: 0.05, g: 0.06, b: 0.09, a: 1}
  textureSize: {x: 800, y: 1100}
  maxFontSize: 64
