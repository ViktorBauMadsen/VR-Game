  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::BlackjackDealer
  head: {fileID: 601762855}
  body: {fileID: 2013499194}
  shoulders:
  - {fileID: 1997374292}
  - {fileID: 790757827}
  hands:
  - {fileID: 1504262387}
  - {fileID: 1309411233}
