  m_Script: {fileID: 11500000, guid: d6bd2defdcfc560478dded90001869da, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::WorldTextPanel
  text: '<align=left><color=#FFD24A><b>CONTROLS</b></color>

    <size=72%><b>LEFT STICK</b>  walk

    <b>RIGHT STICK</b>  turn

    <b>GRIP</b>  grab things, press table buttons (point at or touch them)

    <b>TRIGGER</b>  press menu buttons

    <b>Y</b> (left hand)  open / close the menu


    <color=#FFD24A><b>YOUR MONEY</b></color>

    Top left of your view. Chips are in the pockets at your waist: grab one, drop it on a bet.</size>'
  textColor: {r: 1, g: 1, b: 1, a: 1}
  background: {r: 0.05, g: 0.06, b: 0.09, a: 1}
  textureSize: {x: 800, y: 1100}
  maxFontSize: 64
